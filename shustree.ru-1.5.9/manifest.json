{
    "name": "Shustree",
    "version": "1.5.9",
    "permissions": [
        "proxy",
        "tabs",
        "alarms",
        "storage",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "*://shustree.ru/*",
        "<all_urls>"
    ],
    "description": "Легальное решение для доступа к YouTube, Gemini, ChatGPT, WhatsApp",
    "manifest_version": 3,
    "icons": {
         "16": "img/shustree16.png",
         "32": "img/shustree32.png",
         "48": "img/shustree48.png",
        "128": "img/shustree128.png"
    },
    "background": {
        "service_worker": "shustreeBackground.js"
    },
    "action":{
        "default_popup": "shustree.html",
        "default_title": "Стабильный доступ к YouTube, Gemini, ChatGPT и другим сайтам"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }
}





